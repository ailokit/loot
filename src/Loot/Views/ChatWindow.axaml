<local:LootWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Loot.ViewModels"
        xmlns:local="using:Loot.Views"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:skills="clr-namespace:Loot.AI.Skills"
        xmlns:conversations="clr-namespace:Loot.AI.Conversations"
        x:Class="Loot.Views.ChatWindow"
        x:ClassModifier="internal"
        KeyDown="OnWindowKeyDown"
        x:DataType="vm:ChatWindowViewModel"
        Icon="/Assets/loot.ico"
        Title="{Binding Localization[AppTitle]}" Width="520" Height="700" MinWidth="420" MinHeight="500"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="OnWorkspaceDragOver"
        DragDrop.Drop="OnWorkspaceDrop">
    <local:LootWindow.CustomTitleBarButtons>
        <StackPanel Orientation="Horizontal">
            <ToggleButton Classes="window-action-button"
                                  WindowDecorationProperties.ElementRole="User"
                                  IsChecked="{Binding $parent[Window].Topmost, Mode=TwoWay}"
                                  ToolTip.Tip="{Binding Localization[AlwaysOnTop]}"
                                  AutomationProperties.Name="{Binding Localization[AlwaysOnTop]}"
                                  AutomationProperties.AutomationId="AlwaysOnTopButton">
                <materialIcons:MaterialIcon Kind="PinOutline" Width="16" Height="16" />
            </ToggleButton>
            <Button Classes="window-action-button"
                            WindowDecorationProperties.ElementRole="User"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="{Binding Localization[Settings]}"
                            AutomationProperties.Name="{Binding Localization[Settings]}">
                <materialIcons:MaterialIcon Kind="Settings" Width="16" Height="16" />
            </Button>
        </StackPanel>
    </local:LootWindow.CustomTitleBarButtons>
    <Grid x:Name="WindowLayout" ColumnDefinitions="0,*">
        <Border x:Name="HistoryPanel" Grid.Column="0" Classes="card" Margin="10,2,0,10"
                Padding="8" IsVisible="False">
            <DockPanel LastChildFill="True">
                <Button x:Name="WideNewConversationButton" DockPanel.Dock="Top" Classes="primary-button"
                        Command="{Binding NewConversationCommand}" Height="36" Padding="10,6"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,8"
                        ToolTip.Tip="{Binding Localization[NewConversation]}"
                        AutomationProperties.Name="{Binding Localization[NewConversation]}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18" />
                        <TextBlock Text="{Binding Localization[NewConversation]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ListBox Background="Transparent" BorderBrush="Transparent"
                         ItemsSource="{Binding AppState.Conversations}"
                         SelectedItem="{Binding SelectedConversation}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="conversations:Conversation">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <DockPanel x:Name="ChatLayout" Grid.Column="0" Margin="10,2,10,10" LastChildFill="True" VerticalSpacing="8">
            <DockPanel DockPanel.Dock="Top" LastChildFill="True" HorizontalSpacing="4">
                <Button x:Name="NarrowNewConversationButton" Classes="primary-button" DockPanel.Dock="Right"
                        Command="{Binding NewConversationCommand}"
                        Height="32"
                        ToolTip.Tip="{Binding Localization[NewConversation]}"
                        AutomationProperties.Name="{Binding Localization[NewConversation]}" Padding="8">
                    <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18" />
                </Button>
                <ComboBox x:Name="ConversationComboBox" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding  AppState.Conversations}"
                          SelectedItem="{Binding SelectedConversation}"
                          VerticalAlignment="Center"
                          PlaceholderText="{Binding Localization[HistoryPlaceholder]}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="conversations:Conversation">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" LastChildFill="True" HorizontalSpacing="4">
                <ItemsControl DockPanel.Dock="Right"
                              ItemsSource="{Binding WorkspaceEntries}"
                              IsVisible="{Binding HasWorkspaceEntries}"
                              MaxWidth="280"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Right"
                              ToolTip.Tip="{Binding Localization[SelectWorkspace]}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkspaceEntryViewModel">
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}" Padding="7,4" Margin="0,0,6,0"
                                    ToolTip.Tip="{Binding Path}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Button Classes="transparent-button" Padding="0"
                                            Command="{Binding $parent[Window].DataContext.OpenWorkspaceEntryCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding $parent[Window].DataContext.Localization[OpenWorkspaceEntry]}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14"
                                                                        VerticalAlignment="Center"
                                                                        IsVisible="{Binding IsDirectory}" />
                                            <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="14" Height="14"
                                                                        VerticalAlignment="Center"
                                                                        IsVisible="{Binding IsFile}" />
                                            <TextBlock Text="{Binding DisplayName}" MaxWidth="120"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="transparent-button" Padding="1"
                                            Command="{Binding $parent[Window].DataContext.RemoveWorkspaceEntryCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding $parent[Window].DataContext.Localization[RemoveWorkspaceEntry]}">
                                        <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Spacing="6">
                <ItemsControl ItemsSource="{Binding Attachments}"
                              IsVisible="{Binding HasAttachments}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AttachmentViewModel">
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}" Padding="4" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Classes="transparent-button" Padding="0" Click="OnOpenDraftAttachmentImage"
                                            ToolTip.Tip="{Binding $parent[Window].DataContext.Localization[ViewImage]}"
                                            AutomationProperties.Name="{Binding $parent[Window].DataContext.Localization[ViewImage]}">
                                        <Image
                                            Source="{Binding FilePath, Converter={x:Static local:ImagePathToBitmapConverter.Instance}}"
                                            Width="40" Height="40" Stretch="UniformToFill" />
                                    </Button>
                                    <Button Classes="transparent-button" Padding="2" VerticalAlignment="Center"
                                            Command="{Binding $parent[Window].DataContext.RemoveAttachmentCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding $parent[Window].DataContext.Localization[RemoveAttachment]}">
                                        <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="card" Padding="6">
                    <Grid RowDefinitions="*,Auto" RowSpacing="0">
                        <TextBox x:Name="DraftTextBox" Classes="chat-composer-input" Grid.Row="0"
                                 Text="{Binding Draft, Mode=OneWay}"
                                 TextChanged="OnDraftTextChanged"
                                 PlaceholderText="{Binding Localization[InputPlaceholder]}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 BorderBrush="Transparent" BorderThickness="0" FocusAdorner="{x:Null}"
                                 VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                                 Padding="4,0" MinHeight="46" MaxHeight="180"
                                 CaretBrush="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3"
                                        VerticalAlignment="Center">
                                <Button x:Name="SkillPickerButton" Classes="transparent-button"
                                        Height="32" MaxWidth="120" Padding="4,0"
                                        ToolTip.Tip="{Binding SelectedSkill.Name}"
                                        AutomationProperties.Name="{Binding SelectedSkill.Name}">
                                    <Grid>
                                        <materialIcons:MaterialIcon Kind="ChatOutline" Width="20" Height="20"
                                                                    IsVisible="{Binding IsDefaultSkillSelected}" />
                                        <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                                CornerRadius="{DynamicResource CornerRadiusSmall}" Padding="6,3"
                                                IsVisible="{Binding HasNonDefaultSkillSelected}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="LabelOutline" Width="14" Height="14"
                                                                            VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SelectedSkill.Name}" MaxWidth="88"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout Placement="TopEdgeAlignedLeft">
                                            <ListBox ItemsSource="{Binding AppState.Skills}"
                                                     SelectedItem="{Binding SelectedSkill, Mode=TwoWay}"
                                                     SelectionChanged="OnSkillSelectionChanged"
                                                     MinWidth="220" MaxHeight="320">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="skills:Skill">
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Classes="transparent-button" Width="32" Height="32" Padding="0"
                                        Command="{Binding AddFilesCommand}"
                                        IsVisible="{Binding ShowAddAttachmentButton}"
                                        ToolTip.Tip="{Binding Localization[AddImage]}"
                                        AutomationProperties.Name="{Binding Localization[AddImage]}">
                                    <materialIcons:MaterialIcon Kind="FileImage" Width="18" Height="18" />
                                </Button>
                                <Button Classes="transparent-button" Width="32" Height="32" Padding="0"
                                        ToolTip.Tip="{Binding Localization[SelectWorkspace]}"
                                        AutomationProperties.Name="{Binding Localization[SelectWorkspace]}">
                                    <materialIcons:MaterialIcon Kind="FolderOpen" Width="18" Height="18" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                                            <MenuItem Header="{Binding Localization[SelectWorkspaceFiles]}"
                                                      Command="{Binding AddWorkspaceFilesCommand}" />
                                            <MenuItem Header="{Binding Localization[SelectWorkspaceFolders]}"
                                                      Command="{Binding AddWorkspaceFoldersCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Classes="transparent-button" Width="32" Height="32" Padding="0"
                                        IsEnabled="{Binding HasSessionTools}"
                                        ToolTip.Tip="{Binding Localization[Tools]}"
                                        AutomationProperties.Name="{Binding Localization[Tools]}">
                                    <materialIcons:MaterialIcon Kind="WrenchOutline" Width="18" Height="18" />
                                    <Button.Flyout>
                                        <Flyout Placement="TopEdgeAlignedLeft">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding Localization[Tools]}"
                                                           FontWeight="SemiBold" Margin="2,0,0,2" />
                                                <ToggleSwitch IsChecked="{Binding CleanMode, Mode=TwoWay}"
                                                              OnContent="{Binding Localization[CleanMode]}"
                                                              OffContent="{Binding Localization[CleanMode]}"
                                                              ToolTip.Tip="{Binding Localization[CleanModeDescription]}"
                                                              Padding="4,3" />
                                                <ItemsControl ItemsSource="{Binding SessionTools}"
                                                              IsEnabled="{Binding AreSessionToolsEnabled}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SessionToolSelection">
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      Content="{Binding DisplayName}"
                                                                      ToolTip.Tip="{Binding Description}"
                                                                      Padding="4,3" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <ComboBox Classes="model-picker" ItemsSource="{Binding ModelPickerItems}"
                                          SelectedItem="{Binding SelectedModelPickerItem, Mode=TwoWay}"
                                          Height="36" MinWidth="0"
                                          HorizontalAlignment="Right"
                                          ToolTip.Tip="{Binding SelectedProviderDisplayName}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModelPickerItem">
                                            <Grid>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                           IsVisible="{Binding IsGroupHeader}" />
                                                <TextBlock Text="{Binding DisplayName}" Margin="12,0,0,0"
                                                           IsVisible="{Binding IsModel}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBox.ItemContainerTheme>
                                        <ControlTheme TargetType="ComboBoxItem"
                                                      BasedOn="{StaticResource {x:Type ComboBoxItem}}"
                                                      x:DataType="vm:ModelPickerItem">
                                            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                                        </ControlTheme>
                                    </ComboBox.ItemContainerTheme>
                                </ComboBox>
                                <Button Classes="primary-button" Command="{Binding SendOrStopCommand}"
                                        ToolTip.Tip="{Binding SendButtonText}"
                                        AutomationProperties.Name="{Binding SendButtonText}"
                                        Padding="0" MinHeight="0" VerticalAlignment="Center"
                                        VerticalContentAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="{Binding SendButtonIcon}" Width="18" Height="18" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
            <Border Classes="card" Grid.Row="3" Padding="12">
                <local:ConversationMessagesView ItemsSource="{Binding Messages}" />
            </Border>
        </DockPanel>
    </Grid>
</local:LootWindow>
