<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mac="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             xmlns:fluent="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:markdown="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             x:Class="Loot.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/loot-tray.png"
                      ToolTipText="Loot"
                      mac:MacOSProperties.IsTemplateIcon="True">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Click="OnTrayShowChat" />
                        <NativeMenuItem Click="OnTrayShowSettings" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Click="OnTrayExit" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <fluent:ColorPaletteResources x:Key="Light"
                    Accent="#4F6BF5"
                    BaseHigh="#171A24" BaseMediumHigh="#62697A" BaseMedium="#747B8D" BaseMediumLow="#9298A6" BaseLow="#F6F7F9"
                    AltHigh="#FFFFFF" AltMediumHigh="#E3E6ED" AltMedium="#EEF1F5" AltMediumLow="#F6F7F9" AltLow="#FFFFFF"
                    ChromeHigh="#171A24" ChromeMedium="#62697A" ChromeMediumLow="#9298A6" ChromeLow="#F0F1F5" ChromeAltLow="#F6F7F9"
                    ChromeWhite="#FFFFFF" ChromeBlackHigh="#171A24" ChromeBlackMedium="#62697A" ChromeBlackLow="#9298A6"
                    ChromeDisabledHigh="#9298A6" ChromeDisabledLow="#E3E6ED"
                    ListLow="#F0F2F7" ListMedium="#E9EDFF" RegionColor="#FFFFFF" />
                <fluent:ColorPaletteResources x:Key="Dark"
                    Accent="#8191FF"
                    BaseHigh="#F2F3F7" BaseMediumHigh="#A4A9B9" BaseMedium="#9298A6" BaseMediumLow="#747B8D" BaseLow="#101115"
                    AltHigh="#1A1B22" AltMediumHigh="#30323C" AltMedium="#252731" AltMediumLow="#1A1B22" AltLow="#15161C"
                    ChromeHigh="#F2F3F7" ChromeMedium="#A4A9B9" ChromeMediumLow="#9298A6" ChromeLow="#15161C" ChromeAltLow="#101115"
                    ChromeWhite="#F2F3F7" ChromeBlackHigh="#101115" ChromeBlackMedium="#747B8D" ChromeBlackLow="#30323C"
                    ChromeDisabledHigh="#747B8D" ChromeDisabledLow="#30323C"
                    ListLow="#252731" ListMedium="#292D47" RegionColor="#1A1B22" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
        <!-- Markdown follows the same foreground, surface, border, and accent tokens as the rest of the UI. -->
        <Style Selector="markdown|MarkdownRenderer">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextElement.FontSize" Value="{DynamicResource FontSizeM}" />
        </Style>
        <Style Selector="markdown|MarkdownTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeM}" />
        </Style>
        <Style Selector="markdown|CodeInline">
            <Setter Property="Background" Value="{DynamicResource MarkdownInlineCodeBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MarkdownInlineCodeForegroundBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="Margin" Value="1,0" />
        </Style>
        <Style Selector="markdown|CodeBlock">
            <Setter Property="ColorTheme" Value="VisualStudioLight" />
            <Setter Property="Margin" Value="0,8" />
        </Style>
        <Style Selector="markdown|CodeBlock:dark">
            <Setter Property="ColorTheme" Value="VisualStudioDark" />
        </Style>
        <Style Selector="markdown|Link">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAltAccentBrush}" />
        </Style>
        <!-- Loot UI tokens: compact desktop controls with matching light and dark palettes. -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBox:disabled, ComboBox:disabled, CheckBox:disabled, RadioButton:disabled, ToggleSwitch:disabled, Slider:disabled, ListBoxItem:disabled, MenuItem:disabled">
            <Setter Property="Opacity" Value="0.56" />
        </Style>
        <Style Selector=":is(Button):focus">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAltAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <!-- Shared compact control language layered on top of Fluent. -->
        <Style Selector=":is(Button)">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusButton}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="{DynamicResource DefaultButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DefaultButtonForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DefaultButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(Button):pointerover">
            <Setter Property="Background" Value="{DynamicResource DefaultButtonHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DefaultButtonHoverBorderBrush}" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DefaultButtonHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DefaultButtonHoverBorderBrush}" />
        </Style>
        <Style Selector=":is(Button):pressed">
            <Setter Property="Background" Value="{DynamicResource DefaultButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DefaultButtonBorderBrush}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DefaultButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DefaultButtonBorderBrush}" />
        </Style>
        <Style Selector=":is(Button).default, :is(Button).default-button">
            <Setter Property="Background" Value="{DynamicResource DefaultButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DefaultButtonForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DefaultButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector=":is(Button).default:pointerover, :is(Button).default-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource DefaultButtonHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DefaultButtonHoverBorderBrush}" />
        </Style>
        <Style Selector=":is(Button).default:pressed, :is(Button).default-button:pressed">
            <Setter Property="Background" Value="{DynamicResource DefaultButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DefaultButtonBorderBrush}" />
        </Style>
        <Style Selector="Button.default:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DefaultButtonHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DefaultButtonHoverBorderBrush}" />
        </Style>
        <Style Selector="Button.default-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DefaultButtonHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DefaultButtonHoverBorderBrush}" />
        </Style>
        <Style Selector="Button.default:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DefaultButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DefaultButtonBorderBrush}" />
        </Style>
        <Style Selector="Button.default-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DefaultButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DefaultButtonBorderBrush}" />
        </Style>
        <Style Selector=":is(Button) /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusButton}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(Button) TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(Button) materialIcons|MaterialIcon">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(Button).primary, :is(Button).primary-button">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusControl}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAltAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAltAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector=":is(Button).primary TextBlock, :is(Button).primary-button TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        </Style>
        <Style Selector=":is(Button).primary materialIcons|MaterialIcon, :is(Button).primary-button materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        </Style>
        <Style Selector=":is(Button).primary /template/ ContentPresenter, :is(Button).primary-button /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusControl}" />
        </Style>
        <Style Selector=":is(Button).primary:pointerover, :is(Button).primary-button:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector=":is(Button).primary:pressed, :is(Button).primary-button:pressed">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
        </Style>
        <Style Selector="Button.primary-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAltAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAltAccentBrush}" />
        </Style>
        <Style Selector="Button.primary-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAltAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAltAccentBrush}" />
        </Style>
        <Style Selector=":is(Button).warning, :is(Button).warning-button">
            <Setter Property="Background" Value="{DynamicResource WarningButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WarningButtonForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningButtonBackgroundBrush}" />
        </Style>
        <Style Selector=":is(Button).warning TextBlock, :is(Button).warning-button TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningButtonForegroundBrush}" />
        </Style>
        <Style Selector=":is(Button).warning materialIcons|MaterialIcon, :is(Button).warning-button materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource WarningButtonForegroundBrush}" />
        </Style>
        <Style Selector=":is(Button).warning:pointerover, :is(Button).warning-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource WarningButtonHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningButtonHoverBackgroundBrush}" />
        </Style>
        <Style Selector="Button.warning:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WarningButtonHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningButtonHoverBackgroundBrush}" />
        </Style>
        <Style Selector="Button.warning-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WarningButtonHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningButtonHoverBackgroundBrush}" />
        </Style>
        <Style Selector=":is(Button).warning:pressed, :is(Button).warning-button:pressed">
            <Setter Property="Background" Value="{DynamicResource WarningButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningButtonBackgroundBrush}" />
        </Style>
        <Style Selector="Button.warning:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WarningButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningButtonBackgroundBrush}" />
        </Style>
        <Style Selector="Button.warning-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WarningButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningButtonBackgroundBrush}" />
        </Style>
        <Style Selector=":is(Button).warning:focus, :is(Button).warning-button:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource WarningButtonHoverBackgroundBrush}" />
        </Style>
        <Style Selector=":is(Button).danger, :is(Button).danger-button">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBackgroundBrush}" />
        </Style>
        <Style Selector=":is(Button).danger TextBlock, :is(Button).danger-button TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonForegroundBrush}" />
        </Style>
        <Style Selector=":is(Button).danger materialIcons|MaterialIcon, :is(Button).danger-button materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonForegroundBrush}" />
        </Style>
        <Style Selector=":is(Button).danger:pointerover, :is(Button).danger-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerButtonHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonHoverBackgroundBrush}" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerButtonHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonHoverBackgroundBrush}" />
        </Style>
        <Style Selector="Button.danger-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerButtonHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonHoverBackgroundBrush}" />
        </Style>
        <Style Selector=":is(Button).danger:pressed, :is(Button).danger-button:pressed">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBackgroundBrush}" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBackgroundBrush}" />
        </Style>
        <Style Selector="Button.danger-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBackgroundBrush}" />
        </Style>
        <Style Selector=":is(Button).danger:focus, :is(Button).danger-button:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonHoverBackgroundBrush}" />
        </Style>
        <!-- Disabled buttons keep a solid, visibly separate surface instead of relying on opacity. -->
        <Style Selector=":is(Button):disabled">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{DynamicResource DefaultButtonDisabledBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DefaultButtonDisabledForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DefaultButtonDisabledBorderBrush}" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DefaultButtonDisabledBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DefaultButtonDisabledForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DefaultButtonDisabledBorderBrush}" />
        </Style>
        <Style Selector="Button:disabled TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DefaultButtonDisabledForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button:disabled materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource DefaultButtonDisabledForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector=":is(Button).primary:disabled, :is(Button).primary-button:disabled">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonDisabledBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonDisabledForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonDisabledBorderBrush}" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonDisabledBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonDisabledForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonDisabledBorderBrush}" />
        </Style>
        <Style Selector="Button.primary-button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonDisabledBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonDisabledForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonDisabledBorderBrush}" />
        </Style>
        <Style Selector="Button.primary:disabled TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonDisabledForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.primary-button:disabled TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonDisabledForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.primary:disabled materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonDisabledForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.primary-button:disabled materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonDisabledForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector=":is(Button).warning:disabled, :is(Button).warning-button:disabled">
            <Setter Property="Background" Value="{DynamicResource WarningButtonDisabledBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WarningButtonDisabledForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningButtonDisabledBorderBrush}" />
        </Style>
        <Style Selector="Button.warning:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WarningButtonDisabledBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WarningButtonDisabledForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningButtonDisabledBorderBrush}" />
        </Style>
        <Style Selector="Button.warning-button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WarningButtonDisabledBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WarningButtonDisabledForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningButtonDisabledBorderBrush}" />
        </Style>
        <Style Selector="Button.warning:disabled TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningButtonDisabledForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.warning-button:disabled TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningButtonDisabledForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.warning:disabled materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource WarningButtonDisabledForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.warning-button:disabled materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource WarningButtonDisabledForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector=":is(Button).danger:disabled, :is(Button).danger-button:disabled">
            <Setter Property="Background" Value="{DynamicResource DangerButtonDisabledBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonDisabledForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonDisabledBorderBrush}" />
        </Style>
        <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerButtonDisabledBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonDisabledForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonDisabledBorderBrush}" />
        </Style>
        <Style Selector="Button.danger-button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerButtonDisabledBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonDisabledForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonDisabledBorderBrush}" />
        </Style>
        <Style Selector="Button.danger:disabled TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonDisabledForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.danger-button:disabled TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonDisabledForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.danger:disabled materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonDisabledForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.danger-button:disabled materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonDisabledForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector=":is(Button).transparent-button:disabled, :is(Button).window-action-button:disabled, :is(Button).accent-color-option:disabled">
            <Setter Property="Opacity" Value="0.56" />
        </Style>
        <Style Selector=":is(Button).model-selector-button">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusControl}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector=":is(Button).model-selector-button /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusControl}" />
        </Style>
        <Style Selector=":is(Button).model-selector-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
        <Style Selector=":is(Button).transparent-button /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusItem}" />
        </Style>
        <Style Selector=":is(TextBox)">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusInput}" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputControlBorderBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(TextBox):focus">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAltAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector=":is(ComboBox)">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusInput}" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputControlBorderBrush}" />
        </Style>
        <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusInput}" />
            <Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputControlBorderBrush}" />
        </Style>
        <Style Selector="ComboBox /template/ Border#HighlightBackground">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusInput}" />
            <Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundBrush}" />
        </Style>
        <!-- ComboBox's popup is hosted in a separate visual tree, so its named border
             must be targeted directly instead of through the ComboBox ancestor. -->
        <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder">
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder:light">
            <Setter Property="BoxShadow" Value="0 4 16 0 #14000000" />
        </Style>
        <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder:dark">
            <Setter Property="BoxShadow" Value="0 8 24 0 #40000000" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusItem}" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="ComboBoxItem /template/ Border">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusItem}" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}" />
        </Style>
        <Style Selector=":is(ListBox)">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusControl}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputControlBorderBrush}" />
        </Style>
        <Style Selector=":is(ListBoxItem)">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusItem}" />
        </Style>
        <Style Selector=":is(ListBoxItem):pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
        <Style Selector=":is(ListBoxItem):selected">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}" />
        </Style>
        <Style Selector="Border.settings-list-divider">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector=":is(ListBoxItem):selected Border.settings-list-divider">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- Fluent menus use their own presenter, so apply the shared corner radius directly. -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="MenuFlyoutPresenter /template/ Border">
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="MenuFlyoutPresenter /template/ Border:light">
            <Setter Property="BoxShadow" Value="0 4 16 0 #14000000" />
        </Style>
        <Style Selector="MenuFlyoutPresenter /template/ Border:dark">
            <Setter Property="BoxShadow" Value="0 8 24 0 #40000000" />
        </Style>
        <!-- MenuItem submenus use their own popup border instead of a
             MenuFlyoutPresenter, so style that nested surface separately. -->
        <Style Selector="MenuItem /template/ Popup#PART_Popup Border">
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ContextMenu">
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ContextMenu /template/ Border">
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="FlyoutPresenter">
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="FlyoutPresenter /template/ Border">
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusItem}" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="MenuItem /template/ Border">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusItem}" />
        </Style>
        <Style Selector="MenuItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
        <Style Selector=":is(Button).transparent-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusItem}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(Button).transparent-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
        <Style Selector="Button.transparent-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.transparent-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector=":is(Button).window-action-button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusCompact}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector=":is(Button).window-action-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
        <Style Selector="Button.window-action-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.window-action-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector=":is(Button).window-action-button.close-button:pointerover">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.window-action-button.close-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="BorderBrush" Value="#C42B1C" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        </Style>
        <Style Selector="Border.settings-navigation-menu">
            <Setter Property="Background" Value="{DynamicResource SettingsNavigationBackgroundColor}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusCompact}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsNavigationBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.chat-bubble">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusCard}" />
        </Style>
        <Style Selector="Border.chat-bubble-user">
            <Setter Property="Background" Value="{DynamicResource SecondaryCardBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style Selector="Border.chat-bubble-assistant">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        </Style>
        <Style Selector=":is(CheckBox), :is(RadioButton), :is(ToggleSwitch)">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector=":is(CheckBox):pointerover, :is(RadioButton):pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="MinHeight" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAltAccentBrush}" />
        </Style>
        <Style Selector="Border.thinking-header">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ThinkingHeaderForegroundColor}" />
        </Style>
        <Style Selector="Border.thinking-header TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThinkingHeaderForegroundColor}" />
        </Style>
        <Style Selector="Border.thinking-content">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ThinkingContentForegroundColor}" />
            <Setter Property="TextElement.FontSize" Value="12" />
        </Style>
        <Style Selector="Border.thinking-content TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThinkingContentForegroundColor}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.thinking-content markdown|MarkdownTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThinkingContentForegroundColor}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <!-- Design-system geometry: 4 px compact, 6 px controls, 8 px panels. -->
            <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
            <CornerRadius x:Key="CornerRadiusCompact">4</CornerRadius>
            <CornerRadius x:Key="CornerRadiusItem">4</CornerRadius>
            <CornerRadius x:Key="CornerRadiusButton">6</CornerRadius>
            <CornerRadius x:Key="CornerRadiusInput">6</CornerRadius>
            <CornerRadius x:Key="CornerRadiusControl">6</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="CornerRadiusRound">15</CornerRadius>
            <CornerRadius x:Key="CornerRadiusCard">8</CornerRadius>
            <!-- GitHub Markdown palette. LiveMarkdown resolves these resources dynamically. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F7F9" />
                    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#FBFCFE" />
                    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FBFCFE" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FBFCFE" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#E3E6ED" />
                    <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#171A24" />
                    <Thickness x:Key="ComboBoxDropdownBorderThickness">1</Thickness>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FBFCFE" />
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#E3E6ED" />
                    <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">1</Thickness>
                    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FBFCFE" />
                    <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#E3E6ED" />
                    <Thickness x:Key="FlyoutBorderThemeThickness">1</Thickness>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#171A24" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#62697A" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#9298A6" />
                    <SolidColorBrush x:Key="ErrorBrush" Color="#DC5260" />
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="#E3E6ED" />
                    <SolidColorBrush x:Key="InputControlBorderBrush" Color="#E3E6ED" />
                    <Color x:Key="ForegroundColor">#171A24</Color>
                    <Color x:Key="ThinkingHeaderForegroundColor">#62697A</Color>
                    <Color x:Key="ThinkingContentForegroundColor">#62697A</Color>
                    <Color x:Key="BorderColor">#E3E6ED</Color>
                    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
                    <Color x:Key="SecondaryCardBackgroundColor">#F0F1F5</Color>
                    <Color x:Key="SettingsNavigationBackgroundColor">#F2F3F7</Color>
                    <SolidColorBrush x:Key="SettingsNavigationBorderBrush" Color="#E8EAF0" />
                    <SolidColorBrush x:Key="SettingsListDividerBrush" Color="#E3E6ED" />
                    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DefaultButtonDisabledBackgroundBrush" Color="#E3E6ED" />
                    <SolidColorBrush x:Key="DefaultButtonDisabledForegroundBrush" Color="#62697A" />
                    <SolidColorBrush x:Key="DefaultButtonDisabledBorderBrush" Color="#C4CAD4" />
                    <SolidColorBrush x:Key="PrimaryButtonDisabledBackgroundBrush" Color="#BCC8F3" />
                    <SolidColorBrush x:Key="PrimaryButtonDisabledForegroundBrush" Color="#25345D" />
                    <SolidColorBrush x:Key="PrimaryButtonDisabledBorderBrush" Color="#8998D0" />
                    <SolidColorBrush x:Key="WarningButtonDisabledBackgroundBrush" Color="#F0D8AA" />
                    <SolidColorBrush x:Key="WarningButtonDisabledForegroundBrush" Color="#624516" />
                    <SolidColorBrush x:Key="WarningButtonDisabledBorderBrush" Color="#D6B66F" />
                    <SolidColorBrush x:Key="DangerButtonDisabledBackgroundBrush" Color="#F0C4C8" />
                    <SolidColorBrush x:Key="DangerButtonDisabledForegroundBrush" Color="#7B2F38" />
                    <SolidColorBrush x:Key="DangerButtonDisabledBorderBrush" Color="#D8959C" />
                    <SolidColorBrush x:Key="DefaultButtonBackgroundBrush" Color="#F0F2F7" />
                    <SolidColorBrush x:Key="DefaultButtonForegroundBrush" Color="#171A24" />
                    <SolidColorBrush x:Key="DefaultButtonBorderBrush" Color="#E3E6ED" />
                    <SolidColorBrush x:Key="DefaultButtonHoverBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DefaultButtonHoverBorderBrush" Color="#C0C4CC" />
                    <SolidColorBrush x:Key="DefaultButtonPressedBackgroundBrush" Color="#F0F2F7" />
                    <SolidColorBrush x:Key="DefaultButtonPressedBorderBrush" Color="#E3E6ED" />
                    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="#7185F7" />
                    <SolidColorBrush x:Key="WarningButtonBackgroundBrush" Color="#D99529" />
                    <SolidColorBrush x:Key="WarningButtonForegroundBrush" Color="#241A0D" />
                    <SolidColorBrush x:Key="WarningButtonHoverBackgroundBrush" Color="#E2A541" />
                    <SolidColorBrush x:Key="WarningButtonPressedBackgroundBrush" Color="#D99529" />
                    <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="#DC5260" />
                    <SolidColorBrush x:Key="DangerButtonForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DangerButtonHoverBackgroundBrush" Color="#E66D79" />
                    <SolidColorBrush x:Key="DangerButtonPressedBackgroundBrush" Color="#DC5260" />
                    <Color x:Key="CodeInlineColor">#CF222E</Color>
                    <Color x:Key="QuoteBorderColor">#E3E6ED</Color>
                    <SolidColorBrush x:Key="MarkdownInlineCodeBackgroundBrush" Color="#F0F1F5" />
                    <SolidColorBrush x:Key="MarkdownInlineCodeForegroundBrush" Color="#CF222E" />
                    <x:Double x:Key="FontSizeS">12</x:Double>
                    <x:Double x:Key="FontSizeM">14</x:Double>
                    <x:Double x:Key="FontSizeL">15</x:Double>
                    <x:Double x:Key="FontSizeXl">16</x:Double>
                    <x:Double x:Key="FontSize2Xl">18</x:Double>
                    <x:Double x:Key="FontSize3Xl">20</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101115" />
                    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#1A1B22" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#202129" />
                    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#202129" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#202129" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#30323C" />
                    <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#F2F3F7" />
                    <Thickness x:Key="ComboBoxDropdownBorderThickness">1</Thickness>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#202129" />
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#30323C" />
                    <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">1</Thickness>
                    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#202129" />
                    <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#30323C" />
                    <Thickness x:Key="FlyoutBorderThemeThickness">1</Thickness>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F3F7" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A4A9B9" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#747B8D" />
                    <SolidColorBrush x:Key="ErrorBrush" Color="#F07885" />
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="#30323C" />
                    <SolidColorBrush x:Key="InputControlBorderBrush" Color="#30323C" />
                    <Color x:Key="ForegroundColor">#F2F3F7</Color>
                    <Color x:Key="ThinkingHeaderForegroundColor">#A4A9B9</Color>
                    <Color x:Key="ThinkingContentForegroundColor">#A4A9B9</Color>
                    <Color x:Key="BorderColor">#30323C</Color>
                    <Color x:Key="CardBackgroundColor">#1A1B22</Color>
                    <Color x:Key="SecondaryCardBackgroundColor">#15161C</Color>
                    <Color x:Key="SettingsNavigationBackgroundColor">#15161C</Color>
                    <SolidColorBrush x:Key="SettingsNavigationBorderBrush" Color="#242630" />
                    <SolidColorBrush x:Key="SettingsListDividerBrush" Color="#30323C" />
                    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DefaultButtonDisabledBackgroundBrush" Color="#343741" />
                    <SolidColorBrush x:Key="DefaultButtonDisabledForegroundBrush" Color="#D0D4DC" />
                    <SolidColorBrush x:Key="DefaultButtonDisabledBorderBrush" Color="#585C67" />
                    <SolidColorBrush x:Key="PrimaryButtonDisabledBackgroundBrush" Color="#39466F" />
                    <SolidColorBrush x:Key="PrimaryButtonDisabledForegroundBrush" Color="#E0E5FF" />
                    <SolidColorBrush x:Key="PrimaryButtonDisabledBorderBrush" Color="#536497" />
                    <SolidColorBrush x:Key="WarningButtonDisabledBackgroundBrush" Color="#554326" />
                    <SolidColorBrush x:Key="WarningButtonDisabledForegroundBrush" Color="#F8E7C5" />
                    <SolidColorBrush x:Key="WarningButtonDisabledBorderBrush" Color="#806633" />
                    <SolidColorBrush x:Key="DangerButtonDisabledBackgroundBrush" Color="#563039" />
                    <SolidColorBrush x:Key="DangerButtonDisabledForegroundBrush" Color="#FFE2E5" />
                    <SolidColorBrush x:Key="DangerButtonDisabledBorderBrush" Color="#824651" />
                    <SolidColorBrush x:Key="DefaultButtonBackgroundBrush" Color="#1A1B22" />
                    <SolidColorBrush x:Key="DefaultButtonForegroundBrush" Color="#F2F3F7" />
                    <SolidColorBrush x:Key="DefaultButtonBorderBrush" Color="#45474F" />
                    <SolidColorBrush x:Key="DefaultButtonHoverBackgroundBrush" Color="#292D38" />
                    <SolidColorBrush x:Key="DefaultButtonHoverBorderBrush" Color="#5C5E66" />
                    <SolidColorBrush x:Key="DefaultButtonPressedBackgroundBrush" Color="#1A1B22" />
                    <SolidColorBrush x:Key="DefaultButtonPressedBorderBrush" Color="#45474F" />
                    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="#98A5FF" />
                    <SolidColorBrush x:Key="WarningButtonBackgroundBrush" Color="#F1B75B" />
                    <SolidColorBrush x:Key="WarningButtonForegroundBrush" Color="#2A2114" />
                    <SolidColorBrush x:Key="WarningButtonHoverBackgroundBrush" Color="#F5C675" />
                    <SolidColorBrush x:Key="WarningButtonPressedBackgroundBrush" Color="#F1B75B" />
                    <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="#F07885" />
                    <SolidColorBrush x:Key="DangerButtonForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DangerButtonHoverBackgroundBrush" Color="#F48A95" />
                    <SolidColorBrush x:Key="DangerButtonPressedBackgroundBrush" Color="#F07885" />
                    <Color x:Key="CodeInlineColor">#FF7B72</Color>
                    <Color x:Key="QuoteBorderColor">#30323C</Color>
                    <SolidColorBrush x:Key="MarkdownInlineCodeBackgroundBrush" Color="#292D38" />
                    <SolidColorBrush x:Key="MarkdownInlineCodeForegroundBrush" Color="#FF9A90" />
                    <x:Double x:Key="FontSizeS">12</x:Double>
                    <x:Double x:Key="FontSizeM">14</x:Double>
                    <x:Double x:Key="FontSizeL">15</x:Double>
                    <x:Double x:Key="FontSizeXl">16</x:Double>
                    <x:Double x:Key="FontSize2Xl">18</x:Double>
                    <x:Double x:Key="FontSize3Xl">20</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
