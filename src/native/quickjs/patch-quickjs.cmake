if(NOT DEFINED QUICKJS_SOURCE_DIR)
  message(FATAL_ERROR "QUICKJS_SOURCE_DIR is required")
endif()

set(quickjs_file "${QUICKJS_SOURCE_DIR}/quickjs.c")
file(READ "${quickjs_file}" quickjs_source)
string(REPLACE "return js_free_cstring(ctx->rt, ptr);" "js_free_cstring(ctx->rt, ptr);" patched_source "${quickjs_source}")
string(REPLACE "return js_free_cstring(rt, ptr);" "js_free_cstring(rt, ptr);" patched_source "${patched_source}")
string(FIND "${patched_source}" "return js_free_cstring" remaining_unpatched_return)
if(NOT remaining_unpatched_return EQUAL -1)
  message(FATAL_ERROR "QuickJS still contains an unpatched void-return expression")
endif()

if(NOT patched_source STREQUAL quickjs_source)
  file(WRITE "${quickjs_file}" "${patched_source}")
endif()
