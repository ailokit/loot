<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Version>0.1.19</Version>
        <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\loot.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <IsAotCompatible>true</IsAotCompatible>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <BuildQuickJsNative Condition="'$(BuildQuickJsNative)' == '' and '$(Configuration)' == 'Debug'">true</BuildQuickJsNative>
        <QuickJsBuildDirectory>$(BaseIntermediateOutputPath)quickjs-native/$(Configuration)/$(RuntimeIdentifier)</QuickJsBuildDirectory>
    </PropertyGroup>

    <!-- The compiled XAML metadata is loaded by Avalonia through assembly
         resources at startup, which the trimmer cannot see as a static use. -->
    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <TrimmerRootAssembly Include="$(AssemblyName)" />
    </ItemGroup>

    <!-- Make local output and metadata visibly distinct from release builds. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <AssemblyName>Loot-dev</AssemblyName>
        <AssemblyTitle>Loot-dev</AssemblyTitle>
        <Product>Loot-dev</Product>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishAot>true</PublishAot>
        <PublishTrimmed>true</PublishTrimmed>
        <OptimizationPreference>Size</OptimizationPreference>
        <DebugSymbols>false</DebugSymbols>
        <DebugType>None</DebugType>
        <NativeDebugSymbols>false</NativeDebugSymbols>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <StripSymbols>true</StripSymbols>
        <IsAotCompatible>true</IsAotCompatible>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    </PropertyGroup>

    <Target Name="RemovePublishDebugSymbols" AfterTargets="Publish">
        <ItemGroup>
            <PublishedDebugFiles Include="$(PublishDir)**/*.pdb" />
            <PublishedDebugFiles Include="$(PublishDir)**/*.dbg" />
            <PublishedDebugDirectories Include="$(PublishDir)**/*.dSYM" />
        </ItemGroup>
        <Delete Files="@(PublishedDebugFiles)" />
        <RemoveDir Directories="@(PublishedDebugDirectories)" />
    </Target>

    <Target Name="BuildQuickJsNativeForOutput" BeforeTargets="Build" Condition="'$(BuildQuickJsNative)' == 'true'">
        <Exec Condition="$([MSBuild]::IsOSPlatform('OSX')) Or $([MSBuild]::IsOSPlatform('Linux'))"
              Command="bash &quot;$(MSBuildProjectDirectory)/../native/quickjs/build-native.sh&quot; &quot;$(MSBuildProjectDirectory)/..&quot; &quot;$(QuickJsBuildDirectory)&quot;"
              ContinueOnError="WarnAndContinue" />
        <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
              Command="cmake -S &quot;$(MSBuildProjectDirectory)/../native/quickjs&quot; -B &quot;$(QuickJsBuildDirectory)&quot; -DCMAKE_BUILD_TYPE=$(Configuration)"
              ContinueOnError="WarnAndContinue" />
        <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
              Command="cmake --build &quot;$(QuickJsBuildDirectory)&quot; --config $(Configuration) --target loot_qjs"
              ContinueOnError="WarnAndContinue" />
        <ItemGroup>
            <QuickJsNativeLibrary Include="$(QuickJsBuildDirectory)/**/loot_qjs.dll" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
            <QuickJsNativeLibrary Include="$(QuickJsBuildDirectory)/**/libloot_qjs.dylib" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
            <QuickJsNativeLibrary Include="$(QuickJsBuildDirectory)/**/libloot_qjs.so" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
        </ItemGroup>
        <Error Condition="'@(QuickJsNativeLibrary)' == '' and '$(Configuration)' != 'Debug'" Text="QuickJS-NG native library was not produced." />
        <Copy Condition="'@(QuickJsNativeLibrary)' != ''" SourceFiles="@(QuickJsNativeLibrary)" DestinationFolder="$(OutDir)" />
        <Copy Condition="'@(QuickJsNativeLibrary)' != ''" SourceFiles="$(QuickJsBuildDirectory)/QuickJS-NG-LICENSE.txt;$(MSBuildProjectDirectory)/../native/quickjs/THIRD-PARTY-NOTICES.md" DestinationFolder="$(OutDir)" />
    </Target>

    <Target Name="CopyQuickJsNativeToPublish" AfterTargets="Publish" Condition="'$(BuildQuickJsNative)' == 'true'">
        <ItemGroup>
            <QuickJsPublishLibrary Include="$(QuickJsBuildDirectory)/**/loot_qjs.dll" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
            <QuickJsPublishLibrary Include="$(QuickJsBuildDirectory)/**/libloot_qjs.dylib" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
            <QuickJsPublishLibrary Include="$(QuickJsBuildDirectory)/**/libloot_qjs.so" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
        </ItemGroup>
        <Error Condition="'@(QuickJsPublishLibrary)' == ''" Text="QuickJS-NG native library was not produced." />
        <Copy SourceFiles="@(QuickJsPublishLibrary)" DestinationFolder="$(PublishDir)" />
        <Copy SourceFiles="$(QuickJsBuildDirectory)/QuickJS-NG-LICENSE.txt;$(MSBuildProjectDirectory)/../native/quickjs/THIRD-PARTY-NOTICES.md" DestinationFolder="$(PublishDir)" />
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\Loot.JsonRender.Avalonia\Loot.JsonRender.Avalonia.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Only embed assets that are read by the running UI. The macOS .icns
             file is copied into the app bundle by the release workflow. -->
        <AvaloniaResource Include="Assets\loot.ico" />
        <AvaloniaResource Include="Assets\loot-tray.png" />
        <AvaloniaResource Include="Assets\loot-tray-light.png" />
        <EmbeddedResource Include="Data\CurrentSchema.sql" />
        <EmbeddedResource Update="Localization\Resources.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Remove="Converters\**" />
        <AvaloniaResource Remove="Converters\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="LiveMarkdown.Avalonia" />
        <PackageReference Include="Markdig" />
        <PackageReference Include="Material.Icons.Avalonia" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Cronos" />
        <PackageReference Include="SharpHook" />
        <PackageReference Include="Microsoft.Data.Sqlite" />
        <PackageReference Include="Microsoft.Agents.AI.Harness" />
        <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
        <PackageReference Include="Microsoft.Agents.AI.Tools.Shell" />
        <PackageReference Include="ModelContextProtocol" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
      <AvaloniaXaml Remove="Converters\**" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Converters\**" />
      <Compile Update="Views\LootWindow.axaml.cs">
        <DependentUpon>LootWindow.axaml</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Remove="Converters\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Converters\**" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Loot.Tests" />
    </ItemGroup>
</Project>
