<local:LootWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Loot.Views"
        xmlns:vm="using:Loot.ViewModels"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Loot.Views.SettingsWindow"
        x:ClassModifier="internal"
        x:DataType="vm:SettingsWindowViewModel"
        Title="{Binding Localization[Settings]}" Width="960" Height="640" MinWidth="760" MinHeight="520"
        Icon="/Assets/loot.ico">
    <Grid x:Name="WindowLayout" ColumnDefinitions="auto,*">
            <Border Padding="16">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <TextBlock Text="{Binding Localization[Settings]}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Border Grid.Row="1" Classes="settings-navigation-menu" VerticalAlignment="Top">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListBox x:Name="SettingsNavigation" SelectionMode="Single"
                                 SelectionChanged="OnSettingsSelectionChanged" CornerRadius="{DynamicResource CornerRadiusCompact}">
                        <ListBoxItem Tag="general" HorizontalContentAlignment="Stretch" Padding="8,8,16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="Tune" Width="18" Height="18"/>
                                <TextBlock Text="{Binding Localization[GeneralSettings]}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="history" HorizontalContentAlignment="Stretch" Padding="8,8,16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="History" Width="18" Height="18"/>
                                <TextBlock Text="{Binding Localization[History]}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="scheduled-jobs" HorizontalContentAlignment="Stretch" Padding="8,8,16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="CalendarClock" Width="18" Height="18"/>
                                <TextBlock Text="{Binding Localization[Jobs]}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="api-key" HorizontalContentAlignment="Stretch" Padding="8,8,16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="KeyChange" Width="18" Height="18"/>
                                <TextBlock Text="{Binding Localization[ApiKey]}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="skills" HorizontalContentAlignment="Stretch" Padding="8,8,16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="LightbulbOutline" Width="18" Height="18"/>
                                <TextBlock Text="{Binding Localization[Skills]}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="agent-skills" HorizontalContentAlignment="Stretch" Padding="8,8,16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="LightbulbOnOutline" Width="18" Height="18"/>
                                <TextBlock Text="{Binding Localization[AgentSkills]}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="tools" HorizontalContentAlignment="Stretch" Padding="8,8,16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="WrenchOutline" Width="18" Height="18"/>
                                <TextBlock Text="{Binding Localization[Tools]}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="plugins" HorizontalContentAlignment="Stretch" Padding="8,8,16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="PuzzleOutline" Width="18" Height="18"/>
                                <TextBlock Text="插件"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="mcp" HorizontalContentAlignment="Stretch" Padding="8,8,16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="Connection" Width="18" Height="18"/>
                                <TextBlock Text="{Binding Localization[Mcp]}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="shortcut" HorizontalContentAlignment="Stretch" Padding="8,8,16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="KeyboardOutline" Width="18" Height="18"/>
                                <TextBlock Text="{Binding Localization[Shortcut]}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="about" HorizontalContentAlignment="Stretch" Padding="8,8,16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="InformationOutline" Width="18" Height="18"/>
                                <TextBlock Text="{Binding Localization[About]}"/>
                            </StackPanel>
                        </ListBoxItem>
                        </ListBox>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
            <ContentControl x:Name="SettingsContent" Grid.Column="1" Margin="0,24,24,24"/>
        </Grid>
</local:LootWindow>
