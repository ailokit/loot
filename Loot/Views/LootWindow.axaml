<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Loot.Views"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Loot.Views.LootWindowChrome"
        x:ClassModifier="internal">
    <Grid RowDefinitions="28,*">
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Stretch">
                <TextBlock x:Name="TitleText"
                           Text="{Binding $parent[local:LootWindow].Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="12,0" />
                <StackPanel x:Name="CustomButtonsPanel"
                            Grid.Column="1"
                            Orientation="Horizontal">
                    <ContentPresenter x:Name="CustomTitleBarButtonsHost" />
                    <StackPanel x:Name="StandardWindowButtons" Orientation="Horizontal">
                        <Button Classes="window-action-button"
                                IsVisible="{Binding $parent[local:LootWindow].CanMinimize}"
                                WindowDecorationProperties.ElementRole="MinimizeButton"
                                Click="OnMinimizeWindow"
                                ToolTip.Tip="Minimize">
                            <materialIcons:MaterialIcon Kind="WindowMinimize" Width="16" Height="16" />
                        </Button>
                        <Button Classes="window-action-button"
                                IsVisible="{Binding $parent[local:LootWindow].CanMaximize}"
                                WindowDecorationProperties.ElementRole="MaximizeButton"
                                Click="OnToggleMaximizeWindow"
                                ToolTip.Tip="Maximize">
                            <materialIcons:MaterialIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="16" Height="16" />
                        </Button>
                        <Button Classes="window-action-button close-button"
                                WindowDecorationProperties.ElementRole="CloseButton"
                                Click="OnCloseWindow"
                                ToolTip.Tip="Close">
                            <materialIcons:MaterialIcon Kind="WindowClose" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <ContentPresenter x:Name="WindowContentPresenter" Grid.Row="1" />
        <Border Grid.RowSpan="2" Height="6" VerticalAlignment="Top" Background="Transparent"
                WindowDecorationProperties.ElementRole="ResizeN" />
        <Border Grid.RowSpan="2" Height="6" VerticalAlignment="Bottom" Background="Transparent"
                WindowDecorationProperties.ElementRole="ResizeS" />
        <Border Grid.RowSpan="2" Width="6" HorizontalAlignment="Left" Background="Transparent"
                WindowDecorationProperties.ElementRole="ResizeW" />
        <Border Grid.RowSpan="2" Width="6" HorizontalAlignment="Right" Background="Transparent"
                WindowDecorationProperties.ElementRole="ResizeE" />
        <Border Grid.RowSpan="2" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                WindowDecorationProperties.ElementRole="ResizeNW" />
        <Border Grid.RowSpan="2" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent"
                WindowDecorationProperties.ElementRole="ResizeNE" />
        <Border Grid.RowSpan="2" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent"
                WindowDecorationProperties.ElementRole="ResizeSW" />
        <Border Grid.RowSpan="2" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent"
                WindowDecorationProperties.ElementRole="ResizeSE" />
    </Grid>
</UserControl>
