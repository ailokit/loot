{
  "root": "dashboard",
  "state": {
    "form": {
      "name": "林默",
      "nickname": "小默",
      "account": "linmo@example.com",
      "password": "loot-demo",
      "age": 28,
      "role": "designer",
      "plan": "pro",
      "contactMethod": "email",
      "birthday": "1998-06-18",
      "bio": "热爱整理资料，也喜欢把重复工作交给小工具。",
      "score": 76
    },
    "preferences": {
      "notifications": true,
      "compactMode": false,
      "pinned": true,
      "volume": 35
    },
    "showAdvanced": true,
    "greeting": "修改资料后点击保存，问候语会在这里更新。",
    "draftStatus": "尚未保存",
    "roleNotice": "当前角色：designer",
    "tasks": [
      { "id": "task-1", "title": "检查插件清单", "done": true },
      { "id": "task-2", "title": "整理本周灵感", "done": false },
      { "id": "task-3", "title": "导出项目摘要", "done": false }
    ],
    "groups": [
      { "name": "工作流", "tags": ["快速", "可复用", "本地"] },
      { "name": "设计原则", "tags": ["清晰", "安全"] }
    ],
    "stats": { "completed": 7, "remaining": 3 },
    "available": { "showBeta": true }
  },
  "elements": {
    "dashboard": { "type": "Column", "props": { "gap": "lg" }, "children": ["header", "metrics", "profile-card", "preferences-card", "tasks-card", "groups-card", "conditions-card", "advanced-card", "component-aliases"] },

    "header": { "type": "Row", "props": { "gap": "md" }, "children": ["avatar", "header-copy", "header-badge", "header-icon"] },
    "avatar": { "type": "Avatar", "props": { "name": { "$state": "/form/name" }, "size": 48 }, "children": [] },
    "header-copy": { "type": "Stack", "props": { "gap": 2 }, "children": ["app-title", "welcome-template"] },
    "app-title": { "type": "Text", "props": { "content": "Loot 插件工作台", "variant": "title" }, "children": [] },
    "welcome-template": { "type": "Text", "props": { "text": { "$template": "你好，${/form/name}（${/form/nickname}）。欢迎回来！" }, "variant": "caption" }, "children": [] },
    "header-badge": { "type": "Badge", "props": { "label": "json-render demo" }, "children": [] },
    "header-icon": { "type": "Icon", "props": { "name": "✦", "size": 20 }, "children": [] },

    "metrics": { "type": "HStack", "props": { "gap": "md" }, "children": ["metric-done", "metric-open", "metric-total"] },
    "metric-done": { "type": "Metric", "props": { "label": "已完成", "value": { "$state": "/stats/completed" }, "change": "+2 本周" }, "children": [] },
    "metric-open": { "type": "Metric", "props": { "label": "待处理", "value": { "$state": "/stats/remaining" }, "change": "保持专注" }, "children": [] },
    "metric-total": { "type": "Metric", "props": { "label": "合计", "value": { "$computed": "sum", "args": { "done": { "$state": "/stats/completed" }, "open": { "$state": "/stats/remaining" } } } }, "children": [] },

    "profile-card": {
      "type": "Card",
      "props": { "title": "个人资料", "description": "表单控件使用 $bindState 直接读写工具状态。", "padding": "lg" },
      "slots": { "header": ["profile-title"], "footer": ["save-button", "reset-button"] },
      "children": ["name-input", "nickname-input", "account-input", "password-input", "age-input", "age-number-alias", "role-select", "plan-select", "contact-radio", "birthday-picker", "bio-textarea", "bio-textarea-alias", "bio-textarea-short-alias"]
    },
    "profile-title": { "type": "CardHeader", "props": {}, "children": ["profile-title-text", "profile-title-tag"] },
    "profile-title-text": { "type": "Text", "props": { "content": "基本信息", "variant": "heading" }, "children": [] },
    "profile-title-tag": { "type": "Tag", "props": { "label": "本地保存" }, "children": [] },
    "name-input": { "type": "TextField", "props": { "label": "姓名", "placeholder": "输入姓名", "value": { "$bindState": "/form/name" } }, "children": [] },
    "nickname-input": { "type": "TextInput", "props": { "label": "昵称", "placeholder": "输入昵称", "value": { "$bindState": "/form/nickname" } }, "children": [] },
    "account-input": { "type": "Input", "props": { "label": "邮箱", "placeholder": "name@example.com", "value": { "$bindState": "/form/account" } }, "children": [] },
    "password-input": { "type": "PasswordField", "props": { "label": "演示密码", "placeholder": "输入演示密码", "value": { "$bindState": "/form/password" } }, "children": [] },
    "age-input": { "type": "NumberField", "props": { "label": "年龄", "value": { "$bindState": "/form/age" } }, "children": [] },
    "age-number-alias": { "type": "NumberInput", "props": { "label": "备用数字输入", "value": 12 }, "children": [] },
    "role-select": {
      "type": "Select",
      "props": { "label": "角色", "value": { "$bindState": "/form/role" }, "options": [{ "label": "设计师", "value": "designer" }, { "label": "开发者", "value": "developer" }, { "label": "产品经理", "value": "product" }] },
      "watch": { "/form/role": [{ "action": "roleChanged", "params": { "role": { "$state": "/form/role" } } }, { "action": "saveDraft", "params": { "source": "role watcher" } }] },
      "children": []
    },
    "plan-select": { "type": "ComboBox", "props": { "label": "计划", "value": { "$bindState": "/form/plan" }, "options": ["free", "pro", "team"] }, "children": [] },
    "contact-radio": { "type": "RadioGroup", "props": { "label": "联系偏好", "value": { "$bindState": "/form/contactMethod" }, "options": [{ "label": "电子邮件", "value": "email" }, { "label": "应用内消息", "value": "in-app" }, { "label": "不联系", "value": "none" }] }, "children": [] },
    "birthday-picker": { "type": "DatePicker", "props": { "label": "生日", "value": { "$bindState": "/form/birthday" } }, "children": [] },
    "bio-textarea": { "type": "TextArea", "props": { "label": "个人简介", "placeholder": "介绍一下自己", "minHeight": 72, "value": { "$bindState": "/form/bio" } }, "children": [] },
    "bio-textarea-alias": { "type": "TextAreaField", "props": { "label": "补充备注", "value": "这项使用 TextAreaField 别名。" }, "children": [] },
    "bio-textarea-short-alias": { "type": "Textarea", "props": { "label": "内部笔记", "value": "Textarea 也是可用别名。" }, "children": [] },
    "save-button": { "type": "Button", "props": { "label": "保存并生成问候", "action": "createGreeting", "params": { "name": { "$state": "/form/name" }, "nickname": { "$state": "/form/nickname" }, "role": { "$state": "/form/role" } } }, "children": [] },
    "reset-button": { "type": "IconButton", "props": { "label": "重置示例状态", "action": "resetDemo" }, "children": [] },

    "preferences-card": { "type": "Panel", "props": { "gap": "md" }, "children": ["preferences-title", "preferences-row", "volume-row", "volume-slider", "progress-row", "progress", "progress-alias", "preference-divider", "preference-separator"] },
    "preferences-title": { "type": "Label", "props": { "content": "偏好设置", "variant": "heading" }, "children": [] },
    "preferences-row": { "type": "Row", "props": { "gap": "lg" }, "children": ["notify-checkbox", "compact-checkbox", "switch", "switch-alias", "pin-toggle"] },
    "notify-checkbox": { "type": "CheckBox", "props": { "label": "启用通知", "checked": { "$bindState": "/preferences/notifications" } }, "children": [] },
    "compact-checkbox": { "type": "Checkbox", "props": { "label": "紧凑模式", "checked": { "$bindState": "/preferences/compactMode" } }, "children": [] },
    "switch": { "type": "Switch", "props": { "label": "自动整理", "checked": { "$bindState": "/preferences/compactMode" } }, "children": [] },
    "switch-alias": { "type": "ToggleSwitch", "props": { "label": "接收通知", "checked": { "$bindState": "/preferences/notifications" } }, "children": [] },
    "pin-toggle": { "type": "ToggleButton", "props": { "label": "固定工作台", "pressed": { "$bindState": "/preferences/pinned" } }, "children": [] },
    "volume-row": { "type": "Text", "props": { "text": { "$template": "音量：${/preferences/volume}%" } }, "children": [] },
    "volume-slider": { "type": "Slider", "props": { "min": 0, "max": 100, "step": 5, "showTicks": true, "value": { "$bindState": "/preferences/volume" } }, "children": [] },
    "progress-row": { "type": "Text", "props": { "content": "本周目标进度" }, "children": [] },
    "progress": { "type": "Progress", "props": { "min": 0, "max": 10, "value": { "$state": "/stats/completed" } }, "children": [] },
    "progress-alias": { "type": "ProgressBar", "props": { "isIndeterminate": false, "value": 64 }, "children": [] },
    "preference-divider": { "type": "Divider", "props": {}, "children": [] },
    "preference-separator": { "type": "Separator", "props": {}, "children": [] },

    "tasks-card": { "type": "Card", "props": { "title": "任务清单", "description": "repeat 渲染列表；子元素读取 $item 和 $index，也可以用 $bindItem 修改当前项目。" }, "children": ["task-list"] },
    "task-list": { "type": "ScrollViewer", "props": { "maxHeight": 180 }, "children": ["task-stack"] },
    "task-stack": { "type": "VStack", "props": { "gap": "sm" }, "repeat": { "statePath": "/tasks", "key": "id" }, "children": ["task-row"] },
    "task-row": { "type": "HStack", "props": { "gap": "md" }, "children": ["task-index", "task-title", "task-done"] },
    "task-index": { "type": "Badge", "props": { "label": { "$index": true } }, "children": [] },
    "task-title": { "type": "Text", "props": { "content": { "$item": "title" } }, "children": [] },
    "task-done": { "type": "CheckBox", "props": { "label": "完成", "checked": { "$bindItem": "done" } }, "children": [] },

    "groups-card": { "type": "Group", "props": { "gap": "md" }, "children": ["groups-heading", "group-list"] },
    "groups-heading": { "type": "Text", "props": { "content": "分组与标签（嵌套 repeat）", "variant": "heading" }, "children": [] },
    "group-list": { "type": "Column", "props": { "gap": "sm" }, "repeat": { "statePath": "/groups", "key": "name" }, "children": ["group-card"] },
    "group-card": { "type": "Card", "props": { "padding": "sm" }, "children": ["group-name", "tag-list"] },
    "group-name": { "type": "Text", "props": { "text": { "$template": "分组 ${/form/role} · ${/form/name}" }, "variant": "subheading" }, "children": [] },
    "tag-list": { "type": "HStack", "props": { "gap": "xs" }, "repeat": { "statePath": { "$item": "tags" } }, "children": ["group-tag"] },
    "group-tag": { "type": "Tag", "props": { "label": { "$item": "" } }, "children": [] },

    "conditions-card": { "type": "Card", "props": { "title": "条件、模板与计算值" }, "children": ["role-condition", "age-condition", "score-condition", "plan-condition", "contact-condition", "or-condition", "not-condition", "template-text", "conditional-text", "computed-name", "computed-total", "computed-custom-example"] },
    "role-condition": { "type": "Alert", "props": { "message": "设计师专属提示（eq）", "variant": "info" }, "visible": { "$state": "/form/role", "eq": "designer" }, "children": [] },
    "age-condition": { "type": "Text", "props": { "text": "年龄大于等于 18（gte）" }, "visible": { "$state": "/form/age", "gte": 18 }, "children": [] },
    "score-condition": { "type": "Text", "props": { "text": "分数在 50 到 90 之间（gt + lt）" }, "visible": [{ "$state": "/form/score", "gt": 50 }, { "$state": "/form/score", "lt": 90 }], "children": [] },
    "plan-condition": { "type": "Text", "props": { "text": "计划尚未升级（neq）" }, "visible": { "$state": "/form/plan", "neq": "team" }, "children": [] },
    "contact-condition": { "type": "Text", "props": { "text": "联系偏好不是 none（not + state）" }, "visible": { "$state": "/form/contactMethod", "eq": "none", "not": true }, "children": [] },
    "or-condition": { "type": "Text", "props": { "text": "高级功能可用（$or）" }, "visible": { "$or": [{ "$state": "/available/showBeta" }, { "$state": "/form/plan", "eq": "team" }] }, "children": [] },
    "not-condition": { "type": "Badge", "props": { "label": "通知已关闭" }, "visible": { "$state": "/preferences/notifications", "not": true }, "children": [] },
    "template-text": { "type": "Text", "props": { "text": { "$template": "${/form/name} 当前选择 ${/form/plan} 计划。" } }, "children": [] },
    "conditional-text": { "type": "Text", "props": { "text": { "$cond": { "$state": "/preferences/pinned" }, "$then": "工作台已固定", "$else": "工作台未固定" } }, "children": [] },
    "computed-name": { "type": "Text", "props": { "text": { "$computed": "uppercase", "args": { "value": { "$state": "/form/name" } } } }, "children": [] },
    "computed-total": { "type": "Text", "props": { "text": { "$computed": "sum", "args": { "done": { "$state": "/stats/completed" }, "open": { "$state": "/stats/remaining" } } } }, "children": [] },
    "computed-custom-example": { "type": "Text", "props": { "text": { "$computed": "concat", "args": { "greeting": "你好，", "name": { "$state": "/form/name" }, "suffix": "！" } } }, "children": [] },

    "advanced-card": { "type": "Alert", "props": { "title": "运行结果", "message": { "$state": "/greeting" }, "variant": "success" }, "visible": [{ "$state": "/showAdvanced" }, { "$state": "/form/age", "gte": 18 }], "children": ["draft-status", "role-status"] },
    "draft-status": { "type": "Text", "props": { "content": { "$state": "/draftStatus" }, "variant": "caption" }, "children": [] },
    "role-status": { "type": "Text", "props": { "content": { "$state": "/roleNotice" }, "variant": "caption" }, "children": [] },

    "component-aliases": { "type": "Card", "props": { "title": "容器与组件别名示例" }, "visible": { "$state": "/showAdvanced", "eq": true }, "children": ["alias-row", "input-alias-row", "alias-column", "alias-scroll", "alias-header", "alias-footer", "action-notice"] },
    "alias-row": { "type": "Row", "props": { "gap": "sm" }, "children": ["alias-icon-button", "alias-button"] },
    "alias-icon-button": { "type": "IconButton", "props": { "label": "提示", "action": "showNotice", "params": { "message": "来自 IconButton 的 action" } }, "children": [] },
    "alias-button": { "type": "Button", "props": { "label": "显示通知", "action": "showNotice", "params": { "message": "来自 Button 的 action" } }, "children": [] },
    "input-alias-row": { "type": "Row", "props": { "gap": "sm" }, "children": ["textbox-alias-label", "textbox-alias"] },
    "textbox-alias-label": { "type": "Text", "props": { "text": "TextBox alias:" }, "children": [] },
    "textbox-alias": { "type": "TextBox", "props": { "value": "这是 TextBox 类型别名。" }, "children": [] },
    "alias-column": { "type": "Column", "props": { "gap": "xs" }, "children": ["alias-vstack-label", "alias-stack-label"] },
    "alias-vstack-label": { "type": "Text", "props": { "text": "VStack alias" }, "children": [] },
    "alias-stack-label": { "type": "Text", "props": { "text": "Stack alias" }, "children": [] },
    "alias-scroll": { "type": "ScrollView", "props": {}, "children": ["alias-scroll-label"] },
    "alias-scroll-label": { "type": "Text", "props": { "text": "ScrollView alias" }, "children": [] },
    "alias-header": { "type": "CardHeader", "props": {}, "children": ["alias-header-label"] },
    "alias-header-label": { "type": "Text", "props": { "text": "CardHeader slot component" }, "children": [] },
    "alias-footer": { "type": "CardFooter", "props": {}, "children": ["alias-footer-label"] },
    "alias-footer-label": { "type": "Text", "props": { "text": "CardFooter slot component" }, "children": [] },
    "action-notice": { "type": "Alert", "props": { "message": { "$state": "/roleNotice" }, "variant": "warning" }, "children": [] }
  }
}
